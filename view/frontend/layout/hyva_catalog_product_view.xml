<?xml version="1.0"?>
<!--
/**
 * Hyvä-only overrides for LS Hospitality customizable options.
 *
 */
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.options.wrapper"
                        template="Ls_Hospitality::product/view/options/hyva/wrapper.phtml"/>
        <referenceBlock name="product.info.options.select"
                        template="Ls_Hospitality::product/view/options/hyva/select.phtml">
            <arguments>
                <argument name="view_model" xsi:type="object">Ls\Hospitality\ViewModel\CustomProduct</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
