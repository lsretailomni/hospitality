<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="ls_hospitality_copy_tip_to_order" instance="Ls\Hospitality\Observer\CopyTipToOrderObserver" />
    </event>
    <!-- Register this module with the Hyvä Tailwind build (no effect on Luma) -->
    <event name="hyva_config_generate_before">
        <observer name="ls_hospitality_hyva_config_generate" instance="Ls\Hospitality\Observer\RegisterModuleForHyvaConfig"/>
    </event>
</config>

